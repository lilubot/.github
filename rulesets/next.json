{
  "name": "next-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"include": ["refs/heads/next"], "exclude": []}},
  "bypass_actors": [
    {"actor_id": 4860968, "actor_type": "Integration", "bypass_mode": "always"},
    {"actor_id": 4860787, "actor_type": "Integration", "bypass_mode": "always"}
  ],
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "required_approving_review_count": 0, "dismiss_stale_reviews_on_push": false,
      "require_code_owner_review": false, "require_last_push_approval": false,
      "required_review_thread_resolution": true, "allowed_merge_methods": ["squash"]}},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": true,
      "do_not_enforce_on_create": false,
      "required_status_checks": [
        {"context": "fast / lint"}, {"context": "fast / typecheck"}, {"context": "fast / fast"},
        {"context": "security / zizmor"}, {"context": "security / gitleaks"}, {"context": "security / osv"},
        {"context": "semgrep / semgrep"},
        {"context": "heavy / gate"}
      ]}}
  ]
}
